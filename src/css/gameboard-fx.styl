// Enhanced visual theme for the game board ("visual-fx" setting).
// Everything below is scoped to .gameview.fx-enabled so the classic board is untouched.
// --fx-corp / --fx-runner are set inline from each side's identity faction (nr.gameboard.fx).

fx-cyan = #00e5ff
fx-magenta = #ff2fd0
fx-red = #ff2a3d
fx-gold = #ffc23a
fx-green = #39ff9c
fx-ink = #05070d
fx-glass = rgba(8, 14, 28, 0.78)
fx-mono = "Share Tech Mono", "Consolas", "Menlo", ui-monospace, monospace

// Only participates in layout when the tilted theme is on
.board-plane
    display: contents

.gameview.fx-enabled
    --fx-corp: fx-cyan
    --fx-runner: fx-magenta
    position: relative
    background: fx-ink

    // -----------------------------------------------------------------------
    // Backdrop: the chosen art dimmed, plus a scrolling perspective grid floor

    .gameboard
        position: relative
        isolation: isolate

        > div[class$="-bg"], > .worlds2020
            opacity: 0.35
            filter: saturate(0.6) hue-rotate(-10deg) brightness(0.7)

    .fx-grid-floor
        position: absolute
        top: 0
        left: 0
        right: 0
        bottom: 0
        z-index: -9
        overflow: hidden
        pointer-events: none
        perspective: 600px
        perspective-origin: 50% 35%
        background: radial-gradient(ellipse at 50% 30%, rgba(0, 229, 255, 0.10), transparent 60%), linear-gradient(to bottom, rgba(5, 7, 13, 0.2), rgba(5, 7, 13, 0.75))

        .fx-grid-plane
            position: absolute
            left: -50%
            right: -50%
            top: 35%
            height: 140%
            transform-origin: 50% 0
            transform: rotateX(72deg)
            background-image: linear-gradient(to right, rgba(0, 229, 255, 0.35) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 47, 208, 0.30) 1px, transparent 1px)
            background-size: 60px 60px
            mask-image: linear-gradient(to bottom, transparent, black 20%, black 70%, transparent)
            -webkit-mask-image: linear-gradient(to bottom, transparent, black 20%, black 70%, transparent)
            animation: fx-grid-scroll 6s linear infinite

        .fx-horizon
            position: absolute
            left: 0
            right: 0
            top: 35%
            height: 2px
            background: linear-gradient(to right, transparent, var(--fx-corp), var(--fx-runner), transparent)
            box-shadow: 0 0 18px 4px rgba(0, 229, 255, 0.35)
            opacity: 0.6

    // -----------------------------------------------------------------------
    // Perspective tilt of the play area

    &.fx-tilt
        .centralpane
            perspective: 1800px
            perspective-origin: 50% 0

        .board-plane
            display: flex
            flex-direction: column
            flex: 1
            position: relative
            min-height: 100%
            transform-origin: 50% 100%
            transform: rotateX(9deg)
            transform-style: preserve-3d
            transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1)

            // lean in toward the servers while a run is on
            &.run-active
                transform: rotateX(13deg) translateZ(-20px)

    // -----------------------------------------------------------------------
    // HUD panels: dark glass with a faction-tinted edge

    .blue-shade, .panel
        background-color: fx-glass
        border: 1px solid rgba(0, 229, 255, 0.25)
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.6), 0 0 14px rgba(0, 229, 255, 0.12), inset 0 0 22px rgba(0, 229, 255, 0.05)
        backdrop-filter: blur(3px)

    .stats.active-player
        border-color: var(--fx-runner)
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.6), 0 0 18px rgba(255, 47, 208, 0.35)
        animation: fx-active-pulse 2.4s ease-in-out infinite

    .header, .server-label, .stats, .darkbg
        font-family: fx-mono
        letter-spacing: 0.04em

    .server-label
        color: fx-cyan
        text-shadow: 0 0 6px rgba(0, 229, 255, 0.8)
        text-transform: uppercase
        font-size: 0.7rem

    .darkbg
        background: rgba(5, 10, 20, 0.85)
        border: 1px solid rgba(0, 229, 255, 0.35)
        text-shadow: 0 0 4px rgba(0, 229, 255, 0.7)

    .counter
        box-shadow: 0 0 8px rgba(0, 229, 255, 0.5)

    .advance-counter
        border-color: fx-gold
        box-shadow: 0 0 10px rgba(255, 194, 58, 0.7)
        animation: fx-counter-pulse 1.8s ease-in-out infinite

    .strength
        font-family: fx-mono
        border: 1px solid fx-red
        box-shadow: 0 0 8px rgba(255, 42, 61, 0.6)

    button
        font-family: fx-mono
        text-transform: uppercase
        letter-spacing: 0.06em
        background: linear-gradient(180deg, rgba(0, 229, 255, 0.16), rgba(0, 229, 255, 0.04))
        border: 1px solid rgba(0, 229, 255, 0.55)
        color: #d8fbff
        text-shadow: 0 0 6px rgba(0, 229, 255, 0.6)
        transition: box-shadow 0.15s, background 0.15s, transform 0.1s

        &:hover:not(:disabled)
            background: linear-gradient(180deg, rgba(0, 229, 255, 0.32), rgba(0, 229, 255, 0.1))
            box-shadow: 0 0 12px rgba(0, 229, 255, 0.6)

        &:active:not(:disabled)
            transform: translateY(1px)

    // -----------------------------------------------------------------------
    // Cards: materialise on entry, lift on hover, neon state rings

    img.card.bg
        animation: fx-materialize 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) both

    div.card
        transition: transform 0.18s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.18s, filter 0.18s
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.6)

        &:hover
            transform: translateY(-6px) scale(1.07)
            filter: brightness(1.12)
            box-shadow: 0 14px 24px rgba(0, 0, 0, 0.7), 0 0 14px rgba(0, 229, 255, 0.55)

        // light sweep across the face on hover
        &::after
            content: ""
            position: absolute
            top: 0
            left: 0
            right: 0
            bottom: 0
            border-radius: 4px
            pointer-events: none
            background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.28) 50%, transparent 65%)
            background-size: 250% 100%
            background-position: 150% 0
            opacity: 0
            transition: opacity 0.2s

        &:hover::after
            opacity: 1
            animation: fx-glare 0.8s ease-out

    .card.playable, .card.selectable
        box-shadow: 0 0 0 1px fx-gold, 0 0 12px rgba(255, 194, 58, 0.65)
        animation: fx-ring-gold 1.6s ease-in-out infinite

    .card.selected
        box-shadow: 0 0 0 2px fx-green, 0 0 16px rgba(57, 255, 156, 0.8)

    .card.new
        animation: fx-new-card 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards

    .card.encountered
        animation: fx-encounter 0.9s steps(2, jump-none) infinite, fx-glitch 2.2s steps(1) infinite

    .card.hovered
        box-shadow: 0 0 0 2px fx-cyan, 0 0 18px rgba(0, 229, 255, 0.8)

    // -----------------------------------------------------------------------
    // ICE: cold blue glow when rezzed, faint lattice when not

    .corp-board .ices .ice div.card
        box-shadow: 0 0 0 1px rgba(0, 229, 255, 0.35), 0 0 12px rgba(0, 229, 255, 0.25), 0 6px 14px rgba(0, 0, 0, 0.6)

    // -----------------------------------------------------------------------
    // Runs: the targeted server lights up as a data stream

    .corp-board .server
        transition: filter 0.3s

        &.running
            &::before
                content: ""
                position: absolute
                left: 50%
                top: -20px
                bottom: -20px
                width: 70px
                transform: translateX(-50%)
                pointer-events: none
                z-index: -1
                background: repeating-linear-gradient(to bottom, rgba(255, 47, 208, 0) 0, rgba(255, 47, 208, 0.25) 6px, rgba(0, 229, 255, 0.25) 12px, rgba(0, 229, 255, 0) 18px)
                background-size: 100% 36px
                mask-image: linear-gradient(to right, transparent, black 30%, black 70%, transparent)
                -webkit-mask-image: linear-gradient(to right, transparent, black 30%, black 70%, transparent)
                animation: fx-data-stream 0.6s linear infinite
                filter: blur(0.5px)

            .content .card
                box-shadow: 0 0 0 1px var(--fx-runner), 0 0 18px rgba(255, 47, 208, 0.6)

        &.run-encounter-ice::before
            background: repeating-linear-gradient(to bottom, rgba(255, 42, 61, 0) 0, rgba(255, 42, 61, 0.35) 6px, rgba(255, 194, 58, 0.25) 12px, rgba(255, 42, 61, 0) 18px)
            animation-duration: 0.3s

        &.run-access::before, &.run-success::before
            background: repeating-linear-gradient(to bottom, rgba(57, 255, 156, 0) 0, rgba(57, 255, 156, 0.35) 6px, rgba(0, 229, 255, 0.25) 12px, rgba(57, 255, 156, 0) 18px)

        .ices .run-arrow > div
            background: linear-gradient(to bottom, var(--fx-runner), rgba(255, 47, 208, 0.15))
            box-shadow: 0 0 14px var(--fx-runner)
            border-radius: 0 0 8px 8px
            animation: fx-arrow-pulse 0.9s ease-in-out infinite

            &:before
                border-bottom-color: var(--fx-runner)

            &.encounter
                background: linear-gradient(to bottom, fx-red, rgba(255, 42, 61, 0.15))
                box-shadow: 0 0 16px fx-red

                &:before
                    border-bottom-color: fx-red

    // -----------------------------------------------------------------------
    // Event overlays

    .fx-overlay-layer
        position: absolute
        top: 0
        left: 0
        right: 0
        bottom: 0
        z-index: 50
        pointer-events: none
        overflow: hidden

    .fx-scanlines
        position: absolute
        top: 0
        left: 0
        right: 0
        bottom: 0
        background: repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 0, rgba(255, 255, 255, 0.025) 1px, transparent 1px, transparent 3px)
        mix-blend-mode: overlay

    .fx-vignette
        position: absolute
        top: 0
        left: 0
        right: 0
        bottom: 0
        background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.55) 100%)

    .fx-event
        --fx-c: fx-cyan
        position: absolute
        top: 0
        left: 0
        right: 0
        bottom: 0
        display: flex
        align-items: center
        justify-content: center

        &.fx-score, &.fx-success
            --fx-c: fx-green
        &.fx-steal, &.fx-run
            --fx-c: var(--fx-runner)
        &.fx-fail, &.fx-damage, &.fx-end
            --fx-c: fx-red
        &.fx-tag, &.fx-purge
            --fx-c: fx-gold
        &.fx-rez
            --fx-c: var(--fx-corp)

        .fx-flash
            position: absolute
            top: 0
            left: 0
            right: 0
            bottom: 0
            background: radial-gradient(ellipse at center, var(--fx-c), transparent 70%)
            mix-blend-mode: screen
            animation: fx-flash 0.7s ease-out forwards

        .fx-banner
            position: relative
            padding: 0.4em 1.4em
            font-family: fx-mono
            font-size: 2.6rem
            font-weight: 700
            letter-spacing: 0.18em
            color: #fff
            text-shadow: 0 0 6px var(--fx-c), 0 0 22px var(--fx-c)
            border-top: 2px solid var(--fx-c)
            border-bottom: 2px solid var(--fx-c)
            background: linear-gradient(to right, transparent, rgba(5, 7, 13, 0.85) 15%, rgba(5, 7, 13, 0.85) 85%, transparent)
            white-space: nowrap
            animation: fx-banner 1.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards

            // chromatic split copies for the glitch look
            &::before, &::after
                content: attr(data-text)
                position: absolute
                top: 0.4em
                left: 1.4em
                right: 1.4em
                overflow: hidden
                pointer-events: none

            &::before
                color: fx-magenta
                text-shadow: none
                transform: translateX(-3px)
                clip-path: inset(0 0 55% 0)
                animation: fx-glitch-slice 0.9s steps(2) infinite
                opacity: 0.8

            &::after
                color: fx-cyan
                text-shadow: none
                transform: translateX(3px)
                clip-path: inset(55% 0 0 0)
                animation: fx-glitch-slice 0.7s steps(2) reverse infinite
                opacity: 0.8

        &.fx-rez .fx-banner, &.fx-run .fx-banner
            font-size: 1.6rem

    &.fx-shake .gameboard
        animation: fx-shake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97) both

// ---------------------------------------------------------------------------
// Keyframes

@keyframes fx-grid-scroll
    from
        background-position: 0 0
    to
        background-position: 0 60px

@keyframes fx-active-pulse
    0%, 100%
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.6), 0 0 10px rgba(255, 47, 208, 0.25)
    50%
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.6), 0 0 22px rgba(255, 47, 208, 0.55)

@keyframes fx-counter-pulse
    0%, 100%
        transform: scale(1)
    50%
        transform: scale(1.12)

@keyframes fx-materialize
    0%
        opacity: 0
        transform: scale(1.15) rotateY(70deg)
        filter: brightness(3) hue-rotate(90deg) blur(2px)
    60%
        opacity: 1
        filter: brightness(1.6) hue-rotate(0deg) blur(0)
    100%
        opacity: 1
        transform: none
        filter: none

@keyframes fx-glare
    from
        background-position: 150% 0
    to
        background-position: -50% 0

@keyframes fx-ring-gold
    0%, 100%
        box-shadow: 0 0 0 1px fx-gold, 0 0 6px rgba(255, 194, 58, 0.4)
    50%
        box-shadow: 0 0 0 1px fx-gold, 0 0 16px rgba(255, 194, 58, 0.85)

@keyframes fx-new-card
    0%
        box-shadow: 0 0 0 2px fx-cyan, 0 0 40px 18px rgba(0, 229, 255, 0.7)
    100%
        box-shadow: 0 0 0 1px rgba(0, 229, 255, 0.6), 0 0 0 0 rgba(0, 229, 255, 0)

@keyframes fx-encounter
    0%
        box-shadow: 0 0 0 2px fx-red, 0 0 24px 6px rgba(255, 42, 61, 0.85)
    100%
        box-shadow: 0 0 0 1px fx-red, 0 0 10px 2px rgba(255, 42, 61, 0.5)

@keyframes fx-glitch
    0%, 92%, 100%
        transform: none
        filter: none
    93%
        transform: translate(-2px, 1px) skewX(4deg)
        filter: hue-rotate(60deg) saturate(2)
    95%
        transform: translate(2px, -1px) skewX(-3deg)
    97%
        transform: translate(-1px, 0)
        filter: hue-rotate(-40deg)

@keyframes fx-data-stream
    from
        background-position: 0 36px
    to
        background-position: 0 0

@keyframes fx-arrow-pulse
    0%, 100%
        opacity: 0.75
    50%
        opacity: 1

@keyframes fx-flash
    0%
        opacity: 0.55
    100%
        opacity: 0

@keyframes fx-banner
    0%
        opacity: 0
        transform: scaleX(0.2) scaleY(0.4)
        filter: blur(6px)
    12%
        opacity: 1
        transform: scaleX(1.05) scaleY(1)
        filter: blur(0)
    20%
        transform: scaleX(1)
    80%
        opacity: 1
        transform: scaleX(1)
    100%
        opacity: 0
        transform: scaleX(1.1) scaleY(0.2)
        filter: blur(4px)

@keyframes fx-glitch-slice
    0%
        transform: translateX(-3px)
        clip-path: inset(0 0 60% 0)
    50%
        transform: translateX(4px)
        clip-path: inset(30% 0 35% 0)
    100%
        transform: translateX(-2px)
        clip-path: inset(70% 0 5% 0)

@keyframes fx-shake
    10%, 90%
        transform: translate3d(-1px, 0, 0)
    20%, 80%
        transform: translate3d(3px, 0, 0)
    30%, 50%, 70%
        transform: translate3d(-5px, 1px, 0)
    40%, 60%
        transform: translate3d(5px, -1px, 0)

// Respect the OS "reduce motion" preference: keep the look, drop the movement
@media (prefers-reduced-motion: reduce)
    .gameview.fx-enabled
        *, *::before, *::after
            animation-duration: 0.01ms !important
            animation-iteration-count: 1 !important
            transition-duration: 0.01ms !important

        &.fx-tilt .board-plane
            transform: none
